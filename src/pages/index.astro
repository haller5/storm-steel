      rel="stylesheet"
    />
  </head>

  <body>
    <main>
      <section class="instruments">
        <header class="nameplate">
          <h1>storm-steel</h1>
          <p class="eyebrow">reading &amp; listening instrument log · {firstDate} – {latestDate}</p>

          <div class="manifest">
            <div>
              <span class="manifest-label">7d input</span>
              <span class="manifest-value">{formatNumber(rolling7)}m</span>
            </div>
            <div>
              <span class="manifest-label">contact</span>
              <span class="manifest-value">{contactDays30}/30</span>
            </div>
            <div>
              <span class="manifest-label">balance</span>
              <span class="manifest-value">
                {Math.round(weeklyListeningPct)}L / {Math.round(weeklyReadingPct)}R
                <span class="mini-balance-wrap" set:html={miniBalanceSvg} />
              </span>
            </div>
            <div>
              <span class="manifest-label">fluency momentum</span>
              <span class="manifest-value">
                {momentumArrow(fluencyMomentum)} {formatNumber(fluencyMomentum, 2)} {momentumLabel(fluencyMomentum)}
              </span>
            </div>
          </div>
        </header>

        <div class="instrument-row">
          <div class="panel">
            <p class="panel-label">immersion pressure</p>
            <div class="pressure-wrap" set:html={pressureGaugeSvg} />
          </div>

          <div class="panel">
            <p class="panel-label">reading fluency</p>
            <div class="thermo-wrap" set:html={thermoSvg} />
          </div>

          <div class="panel panel-odometer">
            <p class="panel-label">contact streak</p>
            <div class="odometer">
              {streakDigits.map((d) => <span class="odometer-digit">{d}</span>)}
            </div>
            <p class="odometer-caption">days running</p>
          </div>
        </div>

        <div class="panel barograph-panel">
          <p class="panel-label">reading speed · chars/min</p>
          <div class="chart-wrap" set:html={dailyFluencySvg} />
          <p class="muted">gaps mark days with no reading</p>
        </div>

        <div class="panel barograph-panel">
          <p class="panel-label">input minutes</p>
          <div class="chart-wrap" set:html={inputChartSvg} />
          <p class="muted">solid = daily · dashed = 7d rolling average</p>
        </div>

        <div class="panel ledger-panel">
          <p class="panel-label">immersion log · full history</p>
          <div class="heatmap" style={`grid-template-columns: repeat(${heatmapWeeks}, 15px)`}>
            {paddedHeatmap.map((day) =>
              day ? (
                <span
                  class="heatmap-cell"
                  style={`background-color:${heatColor(day.input)}`}
                  title={`${day.date} · ${Math.round(day.input)}m (${day.listen_min}L/${day.read_min}R)`}
                />
              ) : (
                <span class="heatmap-cell empty" />
              )
            )}
          </div>
          <p class="muted">darker = more input that day · {contactDays30}/30 contact this month</p>
        </div>

        <details class="panel ledger-panel further-readings">
          <summary>further readings</summary>
          <pre>{`momentum               ${momentumArrow(momentum)} ${formatNumber(momentum, 2)} ${momentumLabel(momentum)}   (last 3d vs prior 7d)
volatility             ${formatNumber(volatility)} ${volatilityLabel(volatility)}   (stdev, last 14d)
instability            ${formatNumber(instability, 2)} ${instabilityLabel(instability)}   (volatility / 14d avg)

last listen            ${formatDays(daysSinceListen)}
last read              ${formatDays(daysSinceRead)}
`}</pre>
        </details>
      </section>
    </main>
  </body>
</html>
