---
import '../styles/global.css';

const SHEET_CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vQu-ZcYsIJoKHI3s9KfnuM6qk3Oa-gElXhkUtSk1BfLFBoIFXsBaiZzYdqSoKhxlv_X40HqAAlGbjic/pub?gid=0&single=true&output=csv';

async function fetchDayRecords() {
  const res = await fetch(SHEET_CSV_URL);
  const csvText = await res.text();

  const lines = csvText.trim().split('\n');
  const headers = lines[0].split(',').map((h) => h.trim().toLowerCase());

  return lines
    .slice(1)
    .map((line) => {
      const cells = line.split(',').map((c) => c.trim());
      const row = {};
      headers.forEach((h, i) => (row[h] = cells[i]));

      const date = row.date;
      if (!date) return null;

      const listen_min = Number(row.listen_min ?? 0);
      const read_min = Number(row.read_min ?? 0);
      const read_chars = Number(row.read_chars ?? 0);

      const total_input_min = listen_min + read_min;
      const reading_density = read_min > 0 ? read_chars / read_min : null;

      return {
        date,
        listen_min,
        read_min,
        read_chars,
        total_input_min,
        input: total_input_min,
        contact_day: total_input_min > 0,
        frictionless_minimum: total_input_min >= 5,
        reading_density,
      };
    })
    .filter(Boolean)
    .sort((a, b) => a.date.localeCompare(b.date));
}

const records = await fetchDayRecords();

function addDays(dateString, days) {
  const date = new Date(`${dateString}T00:00:00Z`);
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString().slice(0, 10);
}

function daysBetween(start, end) {
  const a = new Date(`${start}T00:00:00Z`);
  const b = new Date(`${end}T00:00:00Z`);
  return Math.round((b - a) / 86400000);
}

function average(items, key) {
  if (!items.length) return 0;
  return items.reduce((sum, item) => sum + Number(item[key] ?? 0), 0) / items.length;
}

function sum(items, key) {
  return items.reduce((total, item) => total + Number(item[key] ?? 0), 0);
}

function stddev(values) {
  if (!values.length) return 0;
  const avg = values.reduce((a, b) => a + b, 0) / values.length;
  const variance = values.reduce((total, value) => total + (value - avg) ** 2, 0) / values.length;
  return Math.sqrt(variance);
}

function safeRatio(a, b) {
  return b === 0 ? 0 : a / b;
}

const latestDate = records.at(-1)?.date ?? new Date().toISOString().slice(0, 10);
const firstDate = records.at(0)?.date ?? latestDate;
const byDate = new Map(records.map((record) => [record.date, record]));

// Fill missing dates with zeroes so skipped days count.
const days = Array.from({ length: daysBetween(firstDate, latestDate) + 1 }, (_, index) => {
  const date = addDays(firstDate, index);

  return byDate.get(date) ?? {
    date,
    listen_min: 0,
    read_min: 0,
    read_chars: 0,
    total_input_min: 0,
    input: 0,
    contact_day: false,
    frictionless_minimum: false,
    reading_density: null,
  };
});

const last7 = days.slice(-7);
const previous7 = days.slice(-14, -7);
const last14 = days.slice(-14);
const last30 = days.slice(-30);
const last3 = days.slice(-3);
const previous7BeforeLast3 = days.slice(-10, -3);

const inputToday = days.at(-1)?.input ?? 0;

const rolling7 = average(last7, 'input');
const rolling14 = average(last14, 'input');

const contactDays30 = last30.filter((day) => day.contact_day).length;

const avgLast3 = average(last3, 'input');
const avgPrevious7BeforeLast3 = average(previous7BeforeLast3, 'input');
const momentum = safeRatio(avgLast3, avgPrevious7BeforeLast3);

const volatility = stddev(last14.map((day) => day.input));
const instability = safeRatio(volatility, rolling14);

// Health blends three existing signals into one composite reading: are you
// showing up (consistency, last14), is the trend improving or fading
// (momentum), and is the pace steady or erratic (stability = inverse of
// instability). Divides by last14.length rather than a hardcoded 14 so early
// days — before 14 days of history even exist — aren't unfairly penalized.
const contactDays14 = last14.filter((day) => day.contact_day).length;
const consistencyScore = last14.length > 0 ? (contactDays14 / last14.length) * 100 : 0;
const momentumScore = Math.min(100, Math.max(0, 50 + (momentum - 1) * 100));
const stabilityScore = Math.min(100, Math.max(0, 100 - instability * 100));
const healthScore = Math.round((consistencyScore + momentumScore + stabilityScore) / 3);

const healthTiers = [
  { max: 0, label: 'unforged', color: '#8b9498' },
  { max: 25, label: 'corroding', color: '#8b4a3d' },
  { max: 45, label: 'fatigued', color: '#a67a3d' },
  { max: 65, label: 'strained', color: '#9a9143' },
  { max: 85, label: 'forged', color: '#4f6b78' },
  { max: 101, label: 'tempered', color: '#2f4a56' },
];

function healthTier(score) {
  if (score <= 0) return healthTiers[0];
  return healthTiers.find((tier) => score < tier.max) ?? healthTiers.at(-1);
}

const weeklyListen = sum(last7, 'listen_min');
const weeklyRead = sum(last7, 'read_min');
const weeklyInput = weeklyListen + weeklyRead;

const weeklyListeningPct = weeklyInput > 0 ? (weeklyListen / weeklyInput) * 100 : 0;
const weeklyReadingPct = weeklyInput > 0 ? (weeklyRead / weeklyInput) * 100 : 0;

// Target: 70% listening, 30% reading.
const balanceError = Math.abs(weeklyListeningPct - 70) + Math.abs(weeklyReadingPct - 30);

function currentStreak(list, key) {
  let streak = 0;
  for (let i = list.length - 1; i >= 0; i--) {
    if (list[i][key]) streak++;
    else break;
  }
  return streak;
}

const contactStreak = currentStreak(days, 'contact_day');

function daysSince(metric) {
  for (let i = days.length - 1; i >= 0; i--) {
    if (days[i][metric] > 0) return days.length - 1 - i;
  }

  return null;
}

const daysSinceListen = daysSince('listen_min');
const daysSinceRead = daysSince('read_min');

const readingDaysLast7 = last7.filter((day) => day.read_min >= 10 && day.reading_density !== null);

const readingFluency7 = readingDaysLast7.length
  ? readingDaysLast7.reduce((total, day) => total + day.reading_density, 0) / readingDaysLast7.length
  : 0;

const readingSessions = days.filter(
  (day) => day.read_min >= 10 && day.reading_density !== null
);

const last3ReadingSessions = readingSessions.slice(-3);
const previous7ReadingSessions = readingSessions.slice(-10, -3);

function averageReadingDensity(sessions) {
  if (!sessions.length) return 0;

  return (
    sessions.reduce((total, day) => total + day.reading_density, 0) /
    sessions.length
  );
}

const fluencyLast3 = averageReadingDensity(last3ReadingSessions);
const fluencyPrevious7 = averageReadingDensity(previous7ReadingSessions);
const fluencyMomentum = safeRatio(fluencyLast3, fluencyPrevious7);

function formatNumber(value, digits = 1) {
  if (!Number.isFinite(value)) return '0';
  return value.toFixed(digits);
}

function formatDays(value) {
  if (value === null) return 'never';
  if (value === 0) return 'today';
  if (value === 1) return '1d';
  return `${value}d`;
}

function momentumLabel(value) {
  if (value >= 1.1) return 'rising';
  if (value <= 0.9) return 'fading';
  return 'stable';
}

// Small glanceable trend glyph to pair with momentum labels instead of text alone.
function momentumArrow(value) {
  if (value >= 1.1) return '▲';
  if (value <= 0.9) return '▼';
  return '▪';
}

function volatilityLabel(value) {
  if (value <= 10) return 'steady';
  if (value <= 30) return 'uneven';
  return 'volatile';
}

function instabilityLabel(value) {
  if (value <= 0.3) return 'stable';
  if (value <= 0.7) return 'uneven';
  return 'chaotic';
}

const chartDays = days.slice(-14);

const rollingSeries14 = chartDays.map((_, index) => {
  const end = days.length - 14 + index + 1;
  const start = Math.max(0, end - 7);
  return average(days.slice(start, end), 'input');
});

const MONO = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';

// A single graded bar for the composite health score — filled proportionally,
// colored by whichever tier it's currently in, with thin dividers at each
// tier boundary.
function svgHealthBar(score, opts = {}) {
  const { width = 500, height = 60 } = opts;
  const barX = 8;
  const barY = 16;
  const barW = width - barX * 2;
  const barH = 20;

  const clamped = Math.min(Math.max(score, 0), 100);
  const tier = healthTier(score);

  const track = `<rect x="${barX}" y="${barY}" width="${barW}" height="${barH}" fill="#edede6" stroke="#d6d9d2" stroke-width="1.2" />`;
  const fill = `<rect x="${barX}" y="${barY}" width="${(barW * (clamped / 100)).toFixed(1)}" height="${barH}" fill="${tier.color}" />`;

  const boundaries = healthTiers.slice(1, -1).map((t) => t.max);
  const dividers = boundaries
    .map((b) => {
      const bx = barX + barW * (b / 100);
      return `<line x1="${bx.toFixed(1)}" y1="${barY}" x2="${bx.toFixed(1)}" y2="${barY + barH}" stroke="#edede6" stroke-width="1.4" />`;
    })
    .join('');

  const label = `<text x="${barX}" y="${barY + barH + 18}" font-family="${MONO}" font-size="11" fill="${tier.color}">${Math.round(clamped)} · ${tier.label}</text>`;

  return `<svg viewBox="0 0 ${width} ${height}" class="health-svg" role="img" aria-label="immersion health">
  ${track}
  ${fill}
  ${dividers}
  ${label}
</svg>`;
}

const healthBarSvg = svgHealthBar(healthScore);

// Small inline bar for the overview "balance" stat — replaces the old
// full-width balance section + duplicate caption text below it.
function svgMiniBalanceBar(listenPct, readPct, opts = {}) {
  const { width = 72, height = 10 } = opts;
  const listenW = (width * listenPct) / 100;
  const readW = width - listenW;

  return `<svg viewBox="0 0 ${width} ${height}" class="mini-balance-svg" role="img" aria-label="listen vs read balance">
  <rect x="0" y="0" width="${listenW.toFixed(1)}" height="${height}" fill="#4f7a8c" />
  <rect x="${listenW.toFixed(1)}" y="0" width="${readW.toFixed(1)}" height="${height}" fill="#9a9143" />
</svg>`;
}

const miniBalanceSvg = svgMiniBalanceBar(weeklyListeningPct, weeklyReadingPct);

function svgLineChart(values, labels, opts = {}) {
  const {
    width = 640,
    height = 260,
    padLeft = 32,
    padRight = 12,
    padTop = 14,
    padBottom = 24,
    color = '#48545e',
    showDots = true,
    showAxis = true,
    yTicks = 5,
    yMin = 0,
    yMax = null,
    maxMarker = null,
    overlay = null,
    overlayColor = '#8b9498',
  } = opts;

  const innerW = width - padLeft - padRight;
  const innerH = height - padTop - padBottom;
  const numericValues = values.filter((v) => typeof v === 'number' && Number.isFinite(v));
  const overlayNumeric = overlay
    ? overlay.filter((v) => typeof v === 'number' && Number.isFinite(v))
    : [];
  const max = yMax ?? Math.max(...numericValues, ...overlayNumeric, 1);
  const span = max - yMin || 1;

  const x = (i) => padLeft + (values.length <= 1 ? 0 : (i / (values.length - 1)) * innerW);
  const y = (v) => padTop + innerH - ((v - yMin) / span) * innerH;

  // Build the line as separate subpaths, breaking wherever a day has no
  // value at all rather than interpolating straight through the gap.
  let linePath = '';
  let broken = true;
  values.forEach((v, i) => {
    if (typeof v !== 'number' || !Number.isFinite(v)) {
      broken = true;
      return;
    }
    const px = x(i).toFixed(1);
    const py = y(v).toFixed(1);
    linePath += `${broken ? 'M' : 'L'}${px},${py} `;
    broken = false;
  });

  // Optional second series overlaid on the same axes (e.g. a rolling
  // average alongside the raw daily line) — dashed, no dots, own color.
  let overlayPath = '';
  if (overlay) {
    let brokenOverlay = true;
    overlay.forEach((v, i) => {
      if (typeof v !== 'number' || !Number.isFinite(v)) {
        brokenOverlay = true;
        return;
      }
      const px = x(i).toFixed(1);
      const py = y(v).toFixed(1);
      overlayPath += `${brokenOverlay ? 'M' : 'L'}${px},${py} `;
      brokenOverlay = false;
    });
  }
  const overlayEl = overlay
    ? `<path d="${overlayPath}" fill="none" stroke="${overlayColor}" stroke-width="1.6" stroke-dasharray="4 3" stroke-linejoin="round" stroke-linecap="round" />`
    : '';

  const baselineY = y(yMin);
  const baselineLabel =
    yMin !== 0
      ? `<text x="${padLeft - 6}" y="${(baselineY + 3).toFixed(1)}" text-anchor="end" font-size="10" font-family="${MONO}" fill="#48545e">${Math.round(yMin)}</text>`
      : '';
  const baseline = `<line x1="${padLeft}" y1="${baselineY.toFixed(1)}" x2="${width - padRight}" y2="${baselineY.toFixed(1)}" stroke="#48545e" stroke-width="1.4" />${baselineLabel}`;

  const tickLines = showAxis
    ? Array.from({ length: yTicks }, (_, i) => {
        const value = yMin + (span / yTicks) * (i + 1);
        const gy = y(value);
        return `<line x1="${padLeft}" y1="${gy.toFixed(1)}" x2="${width - padRight}" y2="${gy.toFixed(1)}" stroke="#d6d9d2" stroke-width="1" />
<text x="${padLeft - 6}" y="${(gy + 3).toFixed(1)}" text-anchor="end" font-size="10" font-family="${MONO}" fill="#48545e">${Math.round(value)}</text>`;
      }).join('')
    : '';

  const markerLine = maxMarker
    ? (() => {
        const my = y(maxMarker.value);
        return `<line x1="${padLeft}" y1="${my.toFixed(1)}" x2="${width - padRight}" y2="${my.toFixed(1)}" stroke="#8b9498" stroke-width="1.2" stroke-dasharray="0.1 6" stroke-linecap="round" />
<text x="${padLeft - 6}" y="${(my + 3).toFixed(1)}" text-anchor="end" font-size="10" font-family="${MONO}" fill="#48545e">${maxMarker.label}</text>`;
      })()
    : '';

  const dots = showDots
    ? values
        .map((v, i) => {
          if (typeof v !== 'number' || !Number.isFinite(v)) return '';
          return `<text x="${x(i).toFixed(1)}" y="${y(v).toFixed(1)}" text-anchor="middle" dominant-baseline="central" font-family="${MONO}" font-size="17" font-weight="700" fill="${color}">*</text>`;
        })
        .join('')
    : '';

  const xLabels = labels
    .map((label, i) => {
      if (labels.length > 8 && i % 2 !== 0) return '';
      return `<text x="${x(i).toFixed(1)}" y="${height - 6}" text-anchor="middle" font-size="10" font-family="${MONO}" fill="#48545e">${label}</text>`;
    })
    .join('');

  return `<svg viewBox="0 0 ${width} ${height}" class="chart-svg" role="img" aria-label="chart" preserveAspectRatio="xMidYMid meet">
  ${tickLines}
  ${baseline}
  ${markerLine}
  <path d="${linePath}" fill="none" stroke="${color}" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
  ${overlayEl}
  ${dots}
  ${xLabels}
</svg>`;
}

// Combined input chart: solid = daily input, dashed = 7-day rolling average.
// Replaces what used to be two separate, largely overlapping charts.
const inputChartSvg = svgLineChart(
  chartDays.map((day) => day.input),
  chartDays.map((day) => day.date.slice(5)),
  { overlay: rollingSeries14, overlayColor: '#8b9498' }
);

const allTimeMaxFluencyDay = days.reduce((best, day) => {
  if (day.reading_density === null) return best;
  if (!best || day.reading_density > best.reading_density) return day;
  return best;
}, null);

const fluencyAxisMax = allTimeMaxFluencyDay
  ? Math.ceil(allTimeMaxFluencyDay.reading_density * 1.1)
  : null;

const windowFluencyValues = chartDays
  .map((day) => day.reading_density)
  .filter((v) => typeof v === 'number' && Number.isFinite(v));

const fluencyAxisMin = windowFluencyValues.length
  ? Math.max(0, Math.floor((Math.min(...windowFluencyValues) * 0.85) / 5) * 5)
  : 0;

function formatShortDate(dateString) {
  const [year, month, day] = dateString.split('-').map(Number);
  return `${month}.${day}.${String(year).slice(-2)}`;
}

const dailyFluencySvg = svgLineChart(
  chartDays.map((day) => day.reading_density),
  chartDays.map((day) => day.date.slice(5)),
  {
    padLeft: 58,
    yMin: fluencyAxisMin,
    yMax: fluencyAxisMax,
    showAxis: false,
    maxMarker: allTimeMaxFluencyDay
      ? { value: allTimeMaxFluencyDay.reading_density, label: formatShortDate(allTimeMaxFluencyDay.date) }
      : null,
  }
);

const fluencyTiers = [
  { max: 0, label: '—', color: '#8b9498' },
  { max: 15, label: '(•‿•) flutter I', color: '#6f93a3' },
  { max: 25, label: '( •_•) flutter II', color: '#5f8697' },
  { max: 40, label: '( •̀_•́ ) wind I', color: '#4f7a8c' },
  { max: 60, label: '(ง •̀_•́)ง wind II', color: '#3f6b7c' },
  { max: 85, label: '(｀_´) hail I', color: '#6f7a5f' },
  { max: 115, label: '(¬_¬) hail II', color: '#7c8a4f' },
  { max: 150, label: '(ಠ_ಠ) gale I', color: '#8f8a3f' },
  { max: 190, label: "(ง'̀-'́)ง gale II", color: '#a3853f' },
  { max: 230, label: '(◉_◉) torrent I', color: '#b5751b' },
  { max: 270, label: '(ง •̀_•́) torrent II', color: '#b06229' },
  { max: 305, label: '( •̀_•́) tempest I', color: '#a94f2f' },
  { max: 335, label: '(╯°□°）╯ tempest II', color: '#a13f3a' },
  { max: 357, label: '(￣^￣)ゞ storm I', color: '#93384a' },
  { max: 413, label: '(✧_✧) storm II', color: '#7d3560' },
  { max: Infinity, label: 'ฅ(=✧ω✧=)ฅ STURM UND DRANG', color: '#5c2e73' },
];

function fluencyTier(charsPerMin) {
  if (charsPerMin <= 0) return fluencyTiers[0];
  return fluencyTiers.find((tier) => charsPerMin < tier.max) ?? fluencyTiers.at(-1);
}

function weekdayIndexOf(dateString) {
  return new Date(`${dateString}T00:00:00Z`).getUTCDay();
}

// Anki/GitHub-style heatmap over the FULL logged history (not just 30 days),
// colored by quartile of that day's input minutes rather than a fixed
// on/off/threshold split — so it stays meaningful as more days accumulate.
const nonZeroInputs = days.map((d) => d.input).filter((v) => v > 0).sort((a, b) => a - b);

function quantile(arr, q) {
  if (!arr.length) return 0;
  const pos = (arr.length - 1) * q;
  const base = Math.floor(pos);
  const rest = pos - base;
  return arr[base + 1] !== undefined ? arr[base] + rest * (arr[base + 1] - arr[base]) : arr[base];
}

const q25 = quantile(nonZeroInputs, 0.25);
const q50 = quantile(nonZeroInputs, 0.5);
const q75 = quantile(nonZeroInputs, 0.75);

const heatColors = ['#edede6', '#cfe0e6', '#8fb8c9', '#4f7a8c', '#2f4a56'];

function heatColor(mins) {
  if (mins <= 0) return heatColors[0];
  if (mins <= q25) return heatColors[1];
  if (mins <= q50) return heatColors[2];
  if (mins <= q75) return heatColors[3];
  return heatColors[4];
}

const heatmapStart = weekdayIndexOf(days[0].date);
const paddedHeatmap = [...Array.from({ length: heatmapStart }, () => null), ...days];
const heatmapWeeks = Math.ceil(paddedHeatmap.length / 7);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <title>storm-steel</title>
  </head>

  <body>
    <main>
<section class="instruments">
  <h1>storm-steel</h1>
  <p class="eyebrow">reading &amp; listening instrument log · {firstDate} – {latestDate}</p>

  <p class="plain-label">overview</p>
  <div class="summary">
    <p><span>7d input</span><strong>{formatNumber(rolling7)}m</strong></p>
    <p><span>streak</span><strong>{contactStreak}d</strong></p>
    <p><span>contact</span><strong>{contactDays30}/30</strong></p>
    <p>
      <span>balance</span>
      <strong>{Math.round(weeklyListeningPct)}L / {Math.round(weeklyReadingPct)}R</strong>
      <span class="mini-balance-wrap" set:html={miniBalanceSvg} />
    </p>
    <p>
      <span>reading fluency</span>
      <strong
        class="fluency-badge"
        style={`--fc:${fluencyTier(readingFluency7).color}`}
      >{fluencyTier(readingFluency7).label}</strong>
    </p>
    <p>
      <span>fluency momentum</span>
      <strong>{momentumArrow(fluencyMomentum)} {formatNumber(fluencyMomentum, 2)} {momentumLabel(fluencyMomentum)}</strong>
    </p>
  </div>

  <p class="plain-label">immersion health</p>
  <div class="health-wrap" set:html={healthBarSvg} />

  <p class="plain-label">reading speed</p>
  <div class="chart-wrap" set:html={dailyFluencySvg} />
  <p class="muted">chars/min · gaps mark days with no reading</p>

  <p class="plain-label">input minutes</p>
  <div class="chart-wrap" set:html={inputChartSvg} />
  <p class="muted">solid = daily · dashed = 7d rolling average</p>

  <p class="plain-label">immersion heatmap</p>
  <div
    class="heatmap"
    style={`grid-template-columns: repeat(${heatmapWeeks}, 15px)`}
    aria-label="full history contact heatmap"
  >
    {paddedHeatmap.map((day) =>
      day ? (
        <span
          class="heatmap-cell"
          style={`background-color:${heatColor(day.input)}`}
          title={`${day.date} · ${Math.round(day.input)}m (${day.listen_min}L/${day.read_min}R)`}
        />
      ) : (
        <span class="heatmap-cell empty" />
      )
    )}
  </div>
  <p class="muted">darker = more input that day · {contactDays30}/30 contact this month</p>

  <details class="more-metrics">
    <summary>more</summary>
    <pre>{`momentum               ${momentumArrow(momentum)} ${formatNumber(momentum, 2)} ${momentumLabel(momentum)}   (last 3d vs prior 7d)
volatility             ${formatNumber(volatility)} ${volatilityLabel(volatility)}   (stdev, last 14d)
instability            ${formatNumber(instability, 2)} ${instabilityLabel(instability)}   (volatility / 14d avg)

last listen            ${formatDays(daysSinceListen)}
last read              ${formatDays(daysSinceRead)}
`}</pre>
  </details>
</section>

    </main>
  </body>
</html>
