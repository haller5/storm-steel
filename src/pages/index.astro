---
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import { load as parseYaml } from 'js-yaml';
import '../styles/global.css';

const raw = fs.readFileSync(path.resolve('./src/log.md'), 'utf-8');

// Remove optional frontmatter and hide ```log blocks from the visible writing.
const markdownBody = raw.replace(/^---[\s\S]*?---\s*/, '');
const visibleMarkdown = markdownBody.replace(/```log[\s\S]*?```/g, '').trim();
const html = marked.parse(visibleMarkdown);

// Parse dated sections like: ## 2026-08-15
const sectionRegex = /##\s+(\d{4}-\d{2}-\d{2})([^\n]*)\n([\s\S]*?)(?=\n##\s+\d{4}-\d{2}-\d{2}|$)/g;

const records = [...markdownBody.matchAll(sectionRegex)]
  .map((match) => {
    const date = match[1];
    const section = match[3];
    const logMatch = section.match(/```log\s*([\s\S]*?)```/);

    if (!logMatch) return null;

    const data = parseYaml(logMatch[1]) ?? {};

    const listen_min = Number(data.listen_min ?? 0);
    const read_min = Number(data.read_min ?? 0);
    const read_chars = Number(data.read_chars ?? 0);

    const total_input_min = listen_min + read_min;
    const input = total_input_min;
    const contact_day = total_input_min > 0;
    const frictionless_minimum = total_input_min >= 5;
    const reading_density = read_min > 0 ? read_chars / read_min : null;

    return {
      date,
      listen_min,
      read_min,
      read_chars,
      total_input_min,
      input,
      contact_day,
      frictionless_minimum,
      reading_density,
    };
  })
  .filter(Boolean)
  .sort((a, b) => a.date.localeCompare(b.date));

function addDays(dateString, days) {
  const date = new Date(`${dateString}T00:00:00Z`);
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString().slice(0, 10);
}

function daysBetween(start, end) {
  const a = new Date(`${start}T00:00:00Z`);
  const b = new Date(`${end}T00:00:00Z`);
  return Math.round((b - a) / 86400000);
}

function average(items, key) {
  if (!items.length) return 0;
  return items.reduce((sum, item) => sum + Number(item[key] ?? 0), 0) / items.length;
}

function sum(items, key) {
  return items.reduce((total, item) => total + Number(item[key] ?? 0), 0);
}

function stddev(values) {
  if (!values.length) return 0;
  const avg = values.reduce((a, b) => a + b, 0) / values.length;
  const variance = values.reduce((total, value) => total + (value - avg) ** 2, 0) / values.length;
  return Math.sqrt(variance);
}

function safeRatio(a, b) {
  return b === 0 ? 0 : a / b;
}

const latestDate = records.at(-1)?.date ?? new Date().toISOString().slice(0, 10);
const firstDate = records.at(0)?.date ?? latestDate;
const byDate = new Map(records.map((record) => [record.date, record]));

// Fill missing dates with zeroes so skipped days count.
const days = Array.from({ length: daysBetween(firstDate, latestDate) + 1 }, (_, index) => {
  const date = addDays(firstDate, index);

  return byDate.get(date) ?? {
    date,
    listen_min: 0,
    read_min: 0,
    read_chars: 0,
    total_input_min: 0,
    input: 0,
    contact_day: false,
    frictionless_minimum: false,
    reading_density: null,
  };
});

const last7 = days.slice(-7);
const previous7 = days.slice(-14, -7);
const last14 = days.slice(-14);
const last30 = days.slice(-30);
const last3 = days.slice(-3);
const previous7BeforeLast3 = days.slice(-10, -3);

const inputToday = days.at(-1)?.input ?? 0;

const rolling7 = average(last7, 'input');
const rolling14 = average(last14, 'input');

const contactDays30 = last30.filter((day) => day.contact_day).length;
const frictionlessDays30 = last30.filter((day) => day.frictionless_minimum).length;

const avgLast3 = average(last3, 'input');
const avgPrevious7BeforeLast3 = average(previous7BeforeLast3, 'input');
const momentum = safeRatio(avgLast3, avgPrevious7BeforeLast3);

const volatility = stddev(last14.map((day) => day.input));
const instability = safeRatio(volatility, rolling14);

const weeklyListen = sum(last7, 'listen_min');
const weeklyRead = sum(last7, 'read_min');
const weeklyInput = weeklyListen + weeklyRead;

const weeklyListeningPct = weeklyInput > 0 ? (weeklyListen / weeklyInput) * 100 : 0;
const weeklyReadingPct = weeklyInput > 0 ? (weeklyRead / weeklyInput) * 100 : 0;

// Target: 70% listening, 30% reading.
const balanceError = Math.abs(weeklyListeningPct - 70) + Math.abs(weeklyReadingPct - 30);

function currentStreak(list, key) {
  let streak = 0;
  for (let i = list.length - 1; i >= 0; i--) {
    if (list[i][key]) streak++;
    else break;
  }
  return streak;
}

const contactStreak = currentStreak(days, 'contact_day');

function daysSince(metric) {
  for (let i = days.length - 1; i >= 0; i--) {
    if (days[i][metric] > 0) return days.length - 1 - i;
  }

  return null;
}

const daysSinceListen = daysSince('listen_min');
const daysSinceRead = daysSince('read_min');

const readingDaysLast7 = last7.filter((day) => day.read_min >= 10 && day.reading_density !== null);
const readingDaysPrevious7 = previous7.filter((day) => day.read_min >= 10 && day.reading_density !== null);

const readingFluency7 = readingDaysLast7.length
  ? readingDaysLast7.reduce((total, day) => total + day.reading_density, 0) / readingDaysLast7.length
  : 0;

const readingFluencyPrevious7 = readingDaysPrevious7.length
  ? readingDaysPrevious7.reduce((total, day) => total + day.reading_density, 0) / readingDaysPrevious7.length
  : 0;

const readingFluencyTrend = readingFluency7 - readingFluencyPrevious7;

const readingSessions = days.filter(
  (day) => day.read_min >= 10 && day.reading_density !== null
);

const last3ReadingSessions = readingSessions.slice(-3);
const previous7ReadingSessions = readingSessions.slice(-10, -3);

function averageReadingDensity(sessions) {
  if (!sessions.length) return 0;

  return (
    sessions.reduce((total, day) => total + day.reading_density, 0) /
    sessions.length
  );
}

const fluencyLast3 = averageReadingDensity(last3ReadingSessions);
const fluencyPrevious7 = averageReadingDensity(previous7ReadingSessions);
const fluencyMomentum = safeRatio(fluencyLast3, fluencyPrevious7);

const latestReadingDensity = [...days]
  .reverse()
  .find((day) => day.reading_density !== null)?.reading_density ?? 0;

function formatNumber(value, digits = 1) {
  if (!Number.isFinite(value)) return '0';
  return value.toFixed(digits);
}

function formatDays(value) {
  if (value === null) return 'never';
  if (value === 0) return 'today';
  if (value === 1) return '1d';
  return `${value}d`;
}

function momentumLabel(value) {
  if (value >= 1.1) return 'rising';
  if (value <= 0.9) return 'fading';
  return 'stable';
}

function volatilityLabel(value) {
  if (value <= 10) return 'steady';
  if (value <= 30) return 'uneven';
  return 'volatile';
}

function instabilityLabel(value) {
  if (value <= 0.3) return 'stable';
  if (value <= 0.7) return 'uneven';
  return 'chaotic';
}

const chartDays = days.slice(-14);

const rollingSeries14 = chartDays.map((_, index) => {
  const end = days.length - 14 + index + 1;
  const start = Math.max(0, end - 7);
  return average(days.slice(start, end), 'input');
});

const MONO = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';

function svgLineChart(values, labels, opts = {}) {
  const {
    width = 640,
    height = 260,
    padLeft = 32,
    padRight = 12,
    padTop = 14,
    padBottom = 24,
    color = '#48545e',
    showDots = true,
    yTicks = 5,
  } = opts;

  const innerW = width - padLeft - padRight;
  const innerH = height - padTop - padBottom;
  const max = Math.max(...values, 1);

  const x = (i) => padLeft + (values.length <= 1 ? 0 : (i / (values.length - 1)) * innerW);
  const y = (v) => padTop + innerH - (v / max) * innerH;

  const points = values.map((v, i) => [x(i), y(v)]);
  const linePath = points
    .map(([px, py], i) => `${i === 0 ? 'M' : 'L'}${px.toFixed(1)},${py.toFixed(1)}`)
    .join(' ');

  // Baseline (0) drawn bolder, like the old ascii chart's "+----" rule; the rest stay light.
  const gridLines = Array.from({ length: yTicks + 1 }, (_, i) => {
    const value = (max / yTicks) * i;
    const gy = y(value);
    const isBaseline = i === 0;
    return `<line x1="${padLeft}" y1="${gy.toFixed(1)}" x2="${width - padRight}" y2="${gy.toFixed(1)}" stroke="${isBaseline ? '#48545e' : '#d6d9d2'}" stroke-width="${isBaseline ? 1.4 : 1}" />
<text x="${padLeft - 6}" y="${(gy + 3).toFixed(1)}" text-anchor="end" font-size="10" font-family="${MONO}" fill="#48545e">${Math.round(value)}</text>`;
  }).join('');

  // Points are literal asterisks (text glyphs), not circles — a callback to
  // the original hand-plotted "*" chart, just no longer locked to a fixed
  // monospace grid.
  const dots = showDots
    ? points
        .map(([px, py]) => {
          return `<text x="${px.toFixed(1)}" y="${py.toFixed(1)}" text-anchor="middle" dominant-baseline="central" font-family="${MONO}" font-size="17" font-weight="700" fill="${color}">*</text>`;
        })
        .join('')
    : '';

  const xLabels = labels
    .map((label, i) => {
      if (labels.length > 8 && i % 2 !== 0) return '';
      return `<text x="${x(i).toFixed(1)}" y="${height - 6}" text-anchor="middle" font-size="10" font-family="${MONO}" fill="#48545e">${label}</text>`;
    })
    .join('');

  return `<svg viewBox="0 0 ${width} ${height}" class="chart-svg" role="img" aria-label="chart" preserveAspectRatio="xMidYMid meet">
  ${gridLines}
  <path d="${linePath}" fill="none" stroke="${color}" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
  ${dots}
  ${xLabels}
</svg>`;
}

const inputChartSvg = svgLineChart(
  chartDays.map((day) => day.input),
  chartDays.map((day) => day.date.slice(5))
);

const rollingChartSvg = svgLineChart(
  rollingSeries14,
  chartDays.map((day) => day.date.slice(5)),
  { showDots: false }
);

const fluencyTiers = [
  { max: 0, label: '—', color: '#8b9498' },
  { max: 15, label: '(•‿•) flutter I', color: '#6f93a3' },
  { max: 30, label: '( •_•) flutter II', color: '#5f8697' },
  { max: 50, label: '( •̀_•́ ) wind I', color: '#4f7a8c' },
  { max: 75, label: '(ง •̀_•́)ง wind II', color: '#3f6b7c' },
  { max: 100, label: '(｀_´) hail I', color: '#6f7a5f' },
  { max: 140, label: '(¬_¬) hail II', color: '#7c8a4f' },
  { max: 190, label: '(ಠ_ಠ) gale I', color: '#8f8a3f' },
  { max: 250, label: "(ง'̀-'́)ง gale II", color: '#a3853f' },
  { max: 325, label: '(◉_◉) torrent I', color: '#b5751b' },
  { max: 425, label: '(ง •̀_•́) torrent II', color: '#b06229' },
  { max: 550, label: '( •̀_•́) tempest I', color: '#a94f2f' },
  { max: 700, label: '(╯°□°）╯ tempest II', color: '#a13f3a' },
  { max: 900, label: '(￣^￣)ゞ storm I', color: '#93384a' },
  { max: 1200, label: '(✧_✧) storm II', color: '#7d3560' },
  { max: Infinity, label: 'ฅ(=✧ω✧=)ฅ STURM UND DRANG', color: '#5c2e73' },
];

function fluencyTier(charsPerMin) {
  if (charsPerMin <= 0) return fluencyTiers[0];
  return fluencyTiers.find((tier) => charsPerMin < tier.max) ?? fluencyTiers.at(-1);
}

// A horizontal spectrum strip: all 15 real tiers as small neutral blocks in
// a row, with only the current one filled in its actual color. Third distinct
// shape after the dial and the vertical ladder — a level-meter instead of
// either.
function svgFluencyGauge(value, opts = {}) {
  const { width = 320, height = 60 } = opts;
  const padX = 6;
  const barGap = 3;
  const barY = 12;
  const barH = 16;

  const realTiers = fluencyTiers.slice(1); // drop the "no data" placeholder
  const n = realTiers.length;
  const barW = (width - padX * 2 - barGap * (n - 1)) / n;

  const tier = fluencyTier(value);
  const tierIndex = realTiers.indexOf(tier); // -1 when there's no reading data yet

  const bars = realTiers
    .map((t, i) => {
      const bx = padX + i * (barW + barGap);
      const fill = i === tierIndex ? t.color : '#d6d9d2';
      return `<rect x="${bx.toFixed(1)}" y="${barY}" width="${barW.toFixed(1)}" height="${barH}" fill="${fill}" />`;
    })
    .join('');

  const label = `<text x="${(width / 2).toFixed(1)}" y="${barY + barH + 18}" text-anchor="middle" font-family="${MONO}" font-size="11" fill="${tier.color}">${tier.label}</text>`;

  return `<svg viewBox="0 0 ${width} ${height}" class="gauge-svg" role="img" aria-label="reading fluency spectrum">
  ${bars}
  ${label}
</svg>`;
}

const fluencyGaugeSvg = svgFluencyGauge(readingFluency7);

function contactLevel(day) {
  if (day.frictionless_minimum) return 'level-2';
  if (day.contact_day) return 'level-1';
  return 'level-0';
}

// Calendar-grid layout (weeks as columns, Sun-Sat rows) instead of a flat strip.
const calendarStart = weekdayIndexOf(last30[0].date);
const paddedCalendar = [...Array.from({ length: calendarStart }, () => null), ...last30];
const calendarWeeks = Math.ceil(paddedCalendar.length / 7);

function weekdayIndexOf(dateString) {
  return new Date(`${dateString}T00:00:00Z`).getUTCDay();
}

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <title>storm-steel</title>
  </head>

  <body>
    <main>
<section class="instruments">
  <h1>storm-steel</h1>
  <p class="eyebrow">reading &amp; listening instrument log · {firstDate} – {latestDate}</p>

  <p class="plain-label">overview</p>
  <div class="summary">
    <p><span>7d input</span><strong>{formatNumber(rolling7)}m</strong></p>
    <p><span>streak</span><strong>{contactStreak}d</strong></p>
    <p><span>contact</span><strong>{contactDays30}/30</strong></p>
    <p>
      <span>balance</span>
      <strong>{Math.round(weeklyListeningPct)}L / {Math.round(weeklyReadingPct)}R</strong>
    </p>
    <p>
      <span>reading fluency</span>
      <strong
        class="fluency-badge"
        style={`--fc:${fluencyTier(readingFluency7).color}`}
      >{fluencyTier(readingFluency7).label}</strong>
    </p>
    <p>
      <span>fluency momentum</span>
      <strong>{formatNumber(fluencyMomentum, 2)} {momentumLabel(fluencyMomentum)}</strong>
    </p>
  </div>

  <p class="plain-label">reading fluency</p>
  <div class="gauge-wrap" set:html={fluencyGaugeSvg} />

  <p class="plain-label">input minutes</p>
  <div class="chart-wrap" set:html={inputChartSvg} />

  <p class="plain-label">7d rolling average</p>
  <div class="chart-wrap" set:html={rollingChartSvg} />

  <p class="plain-label">contact</p>
  <div
    class="heatmap"
    style={`grid-template-columns: repeat(${calendarWeeks}, 15px)`}
    aria-label="last 30 days contact"
  >
    {paddedCalendar.map((day) =>
      day ? (
        <span
          class:list={['heatmap-cell', contactLevel(day)]}
          title={`${day.date} · ${Math.round(day.input)}m`}
        />
      ) : (
        <span class="heatmap-cell empty" />
      )
    )}
  </div>
  <p class="muted">
    {contactDays30}/30 contact · {frictionlessDays30}/30 frictionless minimum
  </p>

  <p class="plain-label">balance</p>
  <div class="balance-bar" aria-label="listening and reading balance">
    <div
      class="balance-listen"
      style={`width:${weeklyListeningPct}%`}
    ></div>
    <div
      class="balance-read"
      style={`width:${weeklyReadingPct}%`}
    ></div>
  </div>
  <p class="muted">
    {Math.round(weeklyListeningPct)}% listen ·
    {Math.round(weeklyReadingPct)}% read ·
    target 70/30 · error {formatNumber(balanceError)}
  </p>

  <details class="more-metrics">
    <summary>more</summary>
    <pre>{`input today            ${Math.round(inputToday)}m
input 14d avg          ${formatNumber(rolling14)}m

momentum               ${formatNumber(momentum, 2)} ${momentumLabel(momentum)}   (last 3d vs prior 7d)
volatility             ${formatNumber(volatility)} ${volatilityLabel(volatility)}   (stdev, last 14d)
instability            ${formatNumber(instability, 2)} ${instabilityLabel(instability)}   (volatility / 14d avg)

reading density        ${formatNumber(latestReadingDensity)} chars/min
reading trend          ${readingFluencyTrend >= 0 ? '+' : ''}${formatNumber(readingFluencyTrend)} chars/min
fluency last 3         ${formatNumber(fluencyLast3)} chars/min
fluency previous 7     ${formatNumber(fluencyPrevious7)} chars/min

last listen            ${formatDays(daysSinceListen)}
last read              ${formatDays(daysSinceRead)}
`}</pre>
  </details>
</section>
      <hr />

      <article set:html={html} />
    </main>
  </body>
</html>
